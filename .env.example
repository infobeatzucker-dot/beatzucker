# ═══════════════════════════════════════════════════════
#  Beatzucker — Production Environment Variables
#  Copy to .env.local for local dev, set in Docker .env for production
# ═══════════════════════════════════════════════════════

# ── Internal services ────────────────────────────────────────────────────────
# Python FastAPI runs in the same container on port 8001
PYTHON_SERVICE_URL=http://localhost:8001
# REQUIRED in production: separate shared secret for Next.js → Python requests
# Generate independently from NEXTAUTH_SECRET: openssl rand -hex 32
PYTHON_SERVICE_SECRET=
# Total analysis/mastering jobs handled concurrently by the single DSP worker
MAX_CONCURRENT_DSP_JOBS=2
MAX_AUDIO_DURATION_SECONDS=1800
MAX_AUDIO_SAMPLE_RATE=192000

# ── File storage ─────────────────────────────────────────────────────────────
TEMP_UPLOAD_DIR=/app/uploads

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite stored in its own volume, deliberately separate from /app/uploads so
# the temp-file cleanup cron can never delete it
DATABASE_URL=file:/app/data/production.db

# ── Auth (NextAuth) — REQUIRED ──────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
NEXTAUTH_SECRET=
# Your public domain
NEXTAUTH_URL=https://beatzucker.de

# ── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=info@re-beatz.com

# ── E-Mail (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@beatzucker.de
